global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]
      
  - job_name: "rabbitmq"
    static_configs:
      - targets: ["localhost:15692"]

  - job_name: "node_host"
    static_configs:
      - targets: ["localhost:9100"]

  - job_name: "node_workers"
    static_configs:
      - targets:
{% for h in groups['workers'] %}
          - "{{ h }}:9100"
{% endfor %}


  - job_name: "celery_workers"
    scrape_interval: 5s
    static_configs:
      - targets:
{% for h in groups['workers'] %}
          - "{{ h }}:9108"
{% endfor %}